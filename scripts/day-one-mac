#!/usr/bin/env bash
set -euo pipefail

# Portable Day One Mac dispatcher. A standalone installation resolves the
# versioned runtime under ~/.local/share; a source checkout remains supported
# for development.

CANONICAL_STATE_ROOT="${DAY_ONE_MAC_STATE_ROOT:-${FRESH_START_STATE_ROOT:-$HOME/.day-one-mac}}"
LEGACY_STATE_ROOT="$HOME/.fresh-mac-setup"
if [[ -z "${DAY_ONE_MAC_STATE_ROOT:-}" && -z "${FRESH_START_STATE_ROOT:-}" \
   && ! -e "$CANONICAL_STATE_ROOT" && -e "$LEGACY_STATE_ROOT" ]]; then
  STATE_ROOT="$LEGACY_STATE_ROOT"
else
  STATE_ROOT="$CANONICAL_STATE_ROOT"
fi
RUNTIME_FILE="$STATE_ROOT/runtime-root"
LEGACY_ROOT_FILE="$STATE_ROOT/project-root"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_project_root() {
  local candidate=''
  if [[ -x "$SELF_DIR/bootstrap-day-one-mac.sh" ]]; then
    candidate="$(cd "$SELF_DIR/.." && pwd)"
  elif [[ -r "$RUNTIME_FILE" ]]; then
    candidate="$(sed -n '1p' "$RUNTIME_FILE")"
  elif [[ -x "$HOME/.local/share/day-one-mac/current/scripts/bootstrap-day-one-mac.sh" ]]; then
    candidate="$HOME/.local/share/day-one-mac/current"
  elif [[ -r "$LEGACY_ROOT_FILE" ]]; then
    candidate="$(sed -n '1p' "$LEGACY_ROOT_FILE")"
  fi
  [[ "$candidate" == /* && -x "$candidate/scripts/bootstrap-day-one-mac.sh" ]] || return 1
  PROJECT_ROOT="$candidate"
}

bootstrap_checkout() {
  local repository='https://github.com/CodeByKwakes/day-one-mac.git'
  local checkout="$HOME/Developer/github.com/CodeByKwakes/day-one-mac"
  while (( $# )); do
    case "$1" in
      --repository) repository="${2:?--repository requires a Git URL}"; shift 2 ;;
      --checkout) checkout="${2:?--checkout requires an absolute path}"; shift 2 ;;
      -h|--help)
        printf '%s\n' \
          'Usage: day-one-mac bootstrap [--repository URL] [--checkout ABSOLUTE_PATH]' \
          '' \
          'Clone or reuse the project, install the portable command, and print the next step.'
        return 0
        ;;
      *) printf 'Unknown bootstrap option: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  [[ "$checkout" == /* && "$checkout" != / && "$checkout" != "$HOME" ]] || {
    printf 'Refusing unsafe checkout path: %s\n' "$checkout" >&2; return 2; }
  command -v git >/dev/null 2>&1 || {
    printf '%s\n' 'Git is unavailable. Run xcode-select --install, finish the Apple installer, and retry.' >&2
    return 1
  }
  if [[ -d "$checkout/.git" ]]; then
    printf 'Using existing checkout: %s\n' "$checkout"
  elif [[ -e "$checkout" ]]; then
    printf 'Checkout path exists but is not a Git repository: %s\n' "$checkout" >&2
    return 1
  else
    mkdir -p "$(dirname "$checkout")"
    git clone "$repository" "$checkout"
  fi
  if [[ -x "$checkout/scripts/install-portable-command.sh" ]]; then
    PROJECT_ROOT="$checkout"
  else
    PROJECT_ROOT="$checkout/day-one-mac"
  fi
  [[ -x "$PROJECT_ROOT/scripts/install-portable-command.sh" ]] || {
    printf 'The checkout does not contain Day One Mac: %s\n' "$PROJECT_ROOT" >&2; return 1; }
  exec "$PROJECT_ROOT/scripts/install-portable-command.sh" --source "$PROJECT_ROOT" --standalone
}

if [[ "${1:-}" == bootstrap ]]; then
  shift
  bootstrap_checkout "$@"
  exit $?
fi

if ! resolve_project_root; then
  case "${1:-}" in
    help|-h|--help) : ;;
    *)
      printf '%s\n' \
        'The Day One Mac runtime is not installed or recorded.' \
        "Expected state file: $RUNTIME_FILE" \
        '' \
        'Install the public standalone runtime with:' \
        '  ./day-one-mac bootstrap' \
        '' \
        'If a source checkout already exists, run:' \
        '  ./scripts/install-portable-command.sh --standalone' >&2
      exit 1
      ;;
  esac
fi

show_help() {
  cat <<'EOF'
Day One Mac: choose AI-assisted or Manual setup.

AI-assisted: read docs/setup/ai/README.md; prepare a client and choose direct
provider access or OmniRoute before asking the assistant to configure the Mac.
Manual: read docs/setup/manual/README.md and follow the selected tool recipes.
Open the handbook: day-one-mac docs open

Optional reviewed tools (no setup runner or phase-marker prerequisites):
  assistant         preview/export/check a private AI assistant workspace
  tool              --list or --module ID --plan|--apply|--check|--resume
  vscode-profile    default|full-stack|ai|operations; --dry-run previews
  folders           plan/apply/check a selected developer-folder layout
  databases         plan/install/check explicitly selected local test services
  cli-tools         preview or install selected Homebrew formulae
  macos-settings    preview/configure/restore selected macOS preferences
  applications      inspect application ownership and availability
  inventory         write a private application inventory
  shell-status      inspect shell configuration
  safety-report     write a private existing-Mac inspection report
  readiness         inspect policy and recorded evidence
  audit             write a private environment audit
  modules           inspect recorded utility selections and results
  rollback          preview recovery of recorded owned changes
  shortcuts         preview/import the Finder shortcut
  raycast           manage selected integration commands
  workspace         create/open bounded projectless task directories
  second-brain      obsidian|notion; preview before applying

Bundle lifecycle:
  --version         print the active version
  runtime-status    inspect runtime integrity and installed versions
  update            install a verified release; does not update your apps
  rollback-runtime  select a previous runtime; preserves setup records
  uninstall-runtime remove the runtime only; preserves configured apps/data
  docs              browse/export/open bundled guides
  verify            verify runtime integrity, not machine readiness
  validate          contributor checks in a checkout; integrity in a runtime
  root              print the runtime/source location

Compatibility: optional/advanced accept explicit tool operations only.
setup, install, finalize, remove, prepare-existing and broad reset are retired.
Their notices link to migration guidance. Existing state is never deleted.
EOF
}
case "${1:-}" in
  --version|version) printf 'day-one-mac %s\n' "$(sed -n '1p' "$PROJECT_ROOT/VERSION")" ;;
  root) printf '%s\n' "$PROJECT_ROOT" ;;
  ''|help|-h|--help) show_help ;;
  assistant) shift; exec /bin/bash "$PROJECT_ROOT/src/operations/assistant.sh" "$@" ;;
  runtime-status) shift; exec "$PROJECT_ROOT/scripts/runtime-manager.sh" status "$@" ;;
  update) shift; exec "$PROJECT_ROOT/scripts/runtime-manager.sh" update "$@" ;;
  rollback-runtime) shift; exec "$PROJECT_ROOT/scripts/runtime-manager.sh" rollback "$@" ;;
  uninstall-runtime) shift; exec "$PROJECT_ROOT/scripts/runtime-manager.sh" uninstall "$@" ;;
  docs) shift; exec "$PROJECT_ROOT/scripts/runtime-manager.sh" docs "$@" ;;
  tool|optional|advanced)
    shift
    dashboard=0
    dashboard_args=()
    for arg in "$@"; do
      if [[ "$arg" == --status ]]; then dashboard=1; else dashboard_args+=("$arg"); fi
    done
    if [[ "$dashboard" == 1 ]]; then
      for arg in "${dashboard_args[@]+"${dashboard_args[@]}"}"; do
        case "$arg" in --module|--list|--plan|--apply|--resume|--inventory) printf 'Do not combine status with module actions.\n' >&2; exit 2 ;; esac
      done
      exec "$PROJECT_ROOT/scripts/optional-status.sh" ${dashboard_args[@]+"${dashboard_args[@]}"}
    fi
    exec /bin/bash "$PROJECT_ROOT/src/modules/optional-module.sh" "$@" ;;
  optional-status|modules) shift; exec "$PROJECT_ROOT/scripts/optional-status.sh" "$@" ;;
  vscode-profile)
    shift
    case "${1:-}" in
      default|full-stack|ai|operations)
        profile_name="$1"; shift
        exec /bin/bash "$PROJECT_ROOT/scripts/vscode-profiles/$profile_name.sh" "$@" ;;
      ''|help|-h|--help)
        printf '%s\n' 'Usage: day-one-mac vscode-profile default|full-stack|ai|operations [options]' \
          'Use <profile> --help. Preview generation with --dry-run; replacement needs an approved preview hash.' ;;
      *) printf 'Unknown profile. Choose default, full-stack, ai, or operations.\n' >&2; exit 2 ;;
    esac ;;
  second-brain)
    shift
    case "${1:-}" in
      obsidian) shift; exec /bin/bash "$PROJECT_ROOT/extensions/second-brain/obsidian/scripts/second-brain-manager.sh" "$@" ;;
      notion) shift; exec /bin/bash "$PROJECT_ROOT/extensions/second-brain/notion/scripts/notion-second-brain-manager.sh" "$@" ;;
      ''|help|-h|--help) printf '%s\n' 'Usage: day-one-mac second-brain obsidian|notion [options]. Preview is the default.' ;;
      *) printf 'Unknown Second Brain manager.\n' >&2; exit 2 ;;
    esac ;;
  shell-status) shift; exec "$PROJECT_ROOT/scripts/shell-status.sh" "$@" ;;
  verify) shift; exec "$PROJECT_ROOT/scripts/verify.sh" "$@" ;;
  validate)
    shift
    if [[ -x "$PROJECT_ROOT/tools/validate.sh" ]]; then exec "$PROJECT_ROOT/tools/validate.sh" "$@"; fi
    exec "$PROJECT_ROOT/scripts/verify.sh" "$@" ;;
  safety-report|preflight) shift; exec "$PROJECT_ROOT/scripts/preflight-audit.sh" "$@" ;;
  inventory) shift; exec "$PROJECT_ROOT/scripts/application-inventory.sh" "$@" ;;
  applications) shift; exec "$PROJECT_ROOT/scripts/application-status.sh" "$@" ;;
  shortcuts) shift; exec "$PROJECT_ROOT/scripts/configure-shortcuts.sh" "$@" ;;
  raycast) shift; exec "$PROJECT_ROOT/scripts/configure-raycast.sh" "$@" ;;
  workspace) shift; exec "$PROJECT_ROOT/scripts/workspace-manager.sh" "$@" ;;
  macos-settings) shift; exec "$PROJECT_ROOT/scripts/configure-macos-settings.sh" "$@" ;;
  readiness) shift; exec "$PROJECT_ROOT/scripts/workstation-readiness.sh" "$@" ;;
  databases) shift; exec "$PROJECT_ROOT/scripts/configure-databases.sh" "$@" ;;
  advanced-audit|audit) shift; exec "$PROJECT_ROOT/scripts/advanced-audit.sh" "$@" ;;
  cli-tools) shift; exec "$PROJECT_ROOT/scripts/configure-cli-tools.sh" "$@" ;;
  rollback) shift; exec "$PROJECT_ROOT/scripts/rollback-recorded-setup.sh" "$@" ;;
  folders) shift; exec /bin/bash "$PROJECT_ROOT/scripts/configure-folders.sh" "$@" ;;
  ai-setup|setup|install|finalize|remove|clean|reset-development|prepare-existing|prepare-reset|ssh-pin|-*)
    exec /bin/bash "$PROJECT_ROOT/src/operations/retired-setup.sh" "$@" ;;
  *) printf 'Unknown command: %s\nRun day-one-mac --help.\n' "$1" >&2; exit 2 ;;
esac
