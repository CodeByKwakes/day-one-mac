filters:
  and:
    - or:
        - 'file.inFolder("10 Ideas")'
        - 'file.inFolder("20 Drafts")'
        - 'file.inFolder("30 Published")'
        - 'file.inFolder("40 Sources")'
    - 'file.ext == "md"'
properties:
  file.name:
    displayName: Content
  status:
    displayName: Status
  channel:
    displayName: Channel
  publish_date:
    displayName: Publish date
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Pipeline
    filters:
      and:
        - 'status != "published"'
        - 'status != "archived"'
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - channel
      - publish_date
      - file.mtime
  - type: table
    name: Published
    filters:
      and:
        - 'status == "published"'
    order:
      - file.name
      - channel
      - publish_date
