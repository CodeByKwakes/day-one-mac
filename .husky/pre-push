# Git exports repository-local paths to hooks. Fixtures create other repositories;
# inherited paths must never redirect their Git commands into this checkout.
git_local_env="$(git rev-parse --local-env-vars)" || exit 1
for git_env_name in $git_local_env; do
  unset "$git_env_name"
done
unset git_env_name git_local_env
scripts/validate.sh
